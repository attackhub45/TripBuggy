# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Local dev: point at the "tripbuggy" database you create in your own local Postgres.
# Production: connection string from your free Postgres host (e.g. Neon, Supabase).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/tripbuggy

# Any random string works for local dev. Use a real generated secret in production.
JWT_SECRET=change-me-to-a-long-random-string

# Optional for now — the agent runs on simulated logic (see app/agent_service.py) until this
# is set and the TODOs in that file are wired up to real Claude tool calls.
ANTHROPIC_API_KEY=

# Comma-separated list of origins allowed to call this API. Add your deployed frontend's
# URL here in production (e.g. https://tripbuggy.azurestaticapps.net).
CORS_ORIGINS=http://localhost:5173
